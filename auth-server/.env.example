# TavLive Remote Auth Server Configuration Example
PORT=4000
NODE_ENV=development

# JWT Secrets (Must be changed in production!)
JWT_ACCESS_SECRET=tavlive_access_secret_change_me_in_production_32bytes_min
JWT_REFRESH_SECRET=tavlive_refresh_secret_change_me_in_production_32bytes_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Master Admin Key for initial bootstrapping / administrative API calls
ADMIN_API_KEY=tavlive_admin_secret_bootstrap_key_change_me

# Google OAuth 2.0 Credentials (Client Secret must REMAIN strictly on backend)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database file path (SQLite)
DB_FILE_PATH=./data/tavlive_auth.db
