{
  "name": "tikttoklive",
  "version": "1.2.3",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.tavorj.tiktoklive",
    "productName": "GRLive",
    "publish": [
      {
        "provider": "github",
        "owner": "TavoRJ",
        "repo": "Tiktok-control"
      }
    ],
    "files": [
      "**/*",
      "!chatbot_settings.json",
      "!remote_config.json",
      "!dist/**/*",
      "!.git/**/*",
      "!.gitignore"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "keywords": [],
  "author": "TavoRJ",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "node-edge-tts": "^1.2.10",
    "socket.io": "^4.8.3",
    "tiktok-live-connector": "^2.1.1-beta1"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  }
}
